# ALU TRACK — Admin Web
#
# Copy to .env.local for development. Never commit a real .env file.
# Nothing environment-specific is compiled in (docs/12 §2).

# ---------------------------------------------------------------------------
# CFG-13 / OPEN ITEM OI-19 — application timezone
#
# MUST be confirmed with the customer before go-live. A wrong value silently
# corrupts every "today" KPI and every daily snapshot, and the error is normally
# noticed a month after go-live. There is deliberately no plausible default: if
# this is unset the app falls back to UTC and says so in the interface.
#
# Example: Asia/Dubai
NEXT_PUBLIC_APP_TIMEZONE=

# Environment label shown in the sidebar (development | staging | production)
NEXT_PUBLIC_APP_ENV=development

# Shown in the sidebar footer and on support screens
NEXT_PUBLIC_APP_VERSION=0.1.0

# CFG-14 — live-update poll interval for dashboard and inventory watermarks
NEXT_PUBLIC_POLL_INTERVAL_SECONDS=15

# CFG-18 — default table page size
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=50

# ---------------------------------------------------------------------------
# Backend API. Server-side only — the browser never talks to Laravel directly;
# it goes through the Next.js BFF route handlers, which hold the token in an
# httpOnly cookie (docs/02 §5.2).
API_BASE_URL=http://localhost:8000/api/v1
API_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# DEVELOPMENT AUTH STUB — leave unset unless you know why you are setting it.
#
# The Laravel service does not exist yet. Setting this to `true` serves login
# from a local stub so the login screen, BFF handlers, session cookie and
# permission-aware shell can be exercised end to end. It authenticates nobody
# real, refuses to run in a production build, and the console displays a
# permanent warning banner while it is active.
#
# Accounts: admin | yardadmin | supervisor | viewer   Password: alutrack-dev
# (`operator` is present and is correctly refused — PDA operators have no web login.)
#
# Delete this and the lib/auth/dev-stub.ts module once /auth/login is available.
AUTH_DEV_STUB=
