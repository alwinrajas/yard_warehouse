{
  "$schema": "./tokens.schema.md",
  "$meta": {
    "product": "ALU TRACK",
    "description": "THE single source of truth for every colour, type step, spacing value, radius, elevation and motion duration in ALU TRACK. Generated into CSS (web) and Kotlin (PDA) by design-tokens/generate.mjs. Never edit the generated files.",
    "spec": "docs/21-design-system.md",
    "rule": "No hex value may appear anywhere in the codebase outside this file and its generated output."
  },

  "color": {
    "graphite": {
      "0": "#FFFFFF",
      "25": "#FBFCFD",
      "50": "#F6F8FA",
      "100": "#EDF0F4",
      "200": "#DDE3EA",
      "300": "#C3CCD8",
      "400": "#9AA7B8",
      "500": "#647183",
      "600": "#536074",
      "700": "#3D4859",
      "800": "#2A3342",
      "900": "#1B2230",
      "950": "#11161F"
    },
    "anodic": {
      "50": "#EEF4FB",
      "100": "#D8E6F6",
      "200": "#B3CDEC",
      "300": "#7FAADE",
      "400": "#4A84CB",
      "500": "#2A66B3",
      "600": "#1E5196",
      "700": "#184179",
      "800": "#143560",
      "900": "#112B4D"
    },
    "signal": {
      "success-fg": "#15803D",
      "success-surface": "#ECFDF3",
      "success-border": "#ABEFC6",
      "warning-fg": "#B45309",
      "warning-surface": "#FFFAEB",
      "warning-border": "#FEDF89",
      "danger-fg": "#B42318",
      "danger-surface": "#FEF3F2",
      "danger-border": "#FECDCA",
      "info-fg": "#1E5196",
      "info-surface": "#EEF4FB",
      "info-border": "#B3CDEC",
      "neutral-fg": "#536074",
      "neutral-surface": "#F6F8FA",
      "neutral-border": "#DDE3EA"
    },
    "$signalDarkNote": "Feedback colours for the PDA's dark chrome. The light-surface ramp fails WCAG badly on graphite-900 (danger 2.42:1), and the PDA is the screen read in direct sunlight (docs/21 §7).",
    "signal-dark": {
      "success-fg": "#75E0A7",
      "warning-fg": "#FEC84B",
      "danger-fg": "#FDA29B",
      "info-fg": "#7FAADE",
      "neutral-fg": "#9AA7B8",
      "success-surface": "#074D31",
      "warning-surface": "#7A2E0E",
      "danger-surface": "#7A271A"
    }
  },

  "status": {
    "$note": "BRD-visible pallet statuses. 'stored' is deliberately neutral graphite - the normal state must not compete for attention (UX-02, docs/20 §5).",
    "at-collection": {
      "label": "At Collection Point",
      "icon": "Inbox",
      "fg": "#536074",
      "surface": "#EDF0F4",
      "border": "#DDE3EA",
      "dot": "#9AA7B8"
    },
    "stored": {
      "label": "Stored",
      "icon": "Package",
      "fg": "#3D4859",
      "surface": "#F6F8FA",
      "border": "#DDE3EA",
      "dot": "#647183"
    },
    "in-movement": {
      "label": "In Movement",
      "icon": "ArrowLeftRight",
      "fg": "#B45309",
      "surface": "#FFFAEB",
      "border": "#FEDF89",
      "dot": "#B45309"
    },
    "staged": {
      "label": "Staged for Dispatch",
      "icon": "Truck",
      "fg": "#0E7490",
      "surface": "#ECFEFF",
      "border": "#A5F0FC",
      "dot": "#0E7490"
    },
    "dispatched": {
      "label": "Dispatched",
      "icon": "CircleCheck",
      "fg": "#15803D",
      "surface": "#ECFDF3",
      "border": "#ABEFC6",
      "dot": "#15803D"
    },
    "on-hold": {
      "label": "On Hold",
      "icon": "CirclePause",
      "fg": "#C2410C",
      "surface": "#FFF7ED",
      "border": "#FED7AA",
      "dot": "#C2410C"
    },
    "damaged": {
      "label": "Damaged",
      "icon": "TriangleAlert",
      "fg": "#B42318",
      "surface": "#FEF3F2",
      "border": "#FECDCA",
      "dot": "#B42318"
    },
    "exception": {
      "label": "Exception",
      "icon": "OctagonAlert",
      "fg": "#B42318",
      "surface": "#FEF3F2",
      "border": "#FECDCA",
      "dot": "#B42318"
    }
  },

  "location": {
    "$note": "Occupancy states for the zone board. 'pattern' carries the non-colour differentiator required by WCAG 1.4.1, and cell borders meet 3:1 against the canvas per WCAG 1.4.11 because spotting an empty location is a primary task (docs/21 §2.5).",
    "empty": {
      "label": "Empty",
      "fill": "#FFFFFF",
      "border": "#647183",
      "pattern": "none"
    },
    "occupied": {
      "label": "Occupied",
      "fill": "#EEF4FB",
      "border": "#4A84CB",
      "pattern": "none"
    },
    "full": {
      "label": "At capacity",
      "fill": "#D8E6F6",
      "border": "#1E5196",
      "pattern": "none"
    },
    "blocked": {
      "label": "Blocked",
      "fill": "#FFF7ED",
      "border": "#C2410C",
      "pattern": "hatch"
    },
    "inactive": {
      "label": "Inactive",
      "fill": "#EDF0F4",
      "border": "#647183",
      "pattern": "dotted"
    }
  },

  "ageing": {
    "$note": "Bucket boundaries come from CFG-04 and are configurable; these tokens are fixed so a configuration change never requires a design change (docs/21 §2.6).",
    "fresh": { "label": "0-7 days", "fg": "#647183" },
    "normal": { "label": "8-15 days", "fg": "#0E7490" },
    "attention": { "label": "16-30 days", "fg": "#B45309" },
    "critical": { "label": "Over 30 days", "fg": "#B42318" }
  },

  "font": {
    "sans": "var(--font-inter), ui-sans-serif, system-ui, sans-serif",
    "mono": "var(--font-jetbrains-mono), ui-monospace, SFMono-Regular, monospace"
  },

  "text": {
    "$note": "docs/21 §3. Each step is size / line-height / weight / tracking.",
    "display": { "size": "1.875rem", "lineHeight": "2.375rem", "weight": "600", "tracking": "-0.02em" },
    "h1": { "size": "1.5rem", "lineHeight": "2rem", "weight": "600", "tracking": "-0.015em" },
    "h2": { "size": "1.125rem", "lineHeight": "1.625rem", "weight": "600", "tracking": "-0.01em" },
    "h3": { "size": "0.9375rem", "lineHeight": "1.375rem", "weight": "600", "tracking": "0" },
    "body": { "size": "0.875rem", "lineHeight": "1.25rem", "weight": "400", "tracking": "0" },
    "body-sm": { "size": "0.8125rem", "lineHeight": "1.125rem", "weight": "400", "tracking": "0" },
    "label": { "size": "0.8125rem", "lineHeight": "1.125rem", "weight": "500", "tracking": "0" },
    "caption": { "size": "0.75rem", "lineHeight": "1rem", "weight": "400", "tracking": "0" },
    "overline": { "size": "0.6875rem", "lineHeight": "0.875rem", "weight": "600", "tracking": "0.06em" },
    "mono": { "size": "0.8125rem", "lineHeight": "1.125rem", "weight": "500", "tracking": "-0.01em" },
    "mono-lg": { "size": "1rem", "lineHeight": "1.375rem", "weight": "600", "tracking": "-0.01em" },
    "mono-xl": { "size": "1.75rem", "lineHeight": "2.125rem", "weight": "600", "tracking": "-0.02em" }
  },

  "radius": {
    "sm": "0.25rem",
    "md": "0.375rem",
    "lg": "0.5rem",
    "xl": "0.75rem"
  },

  "shadow": {
    "$note": "Three levels only. Shadow indicates layering, never importance (docs/21 §4).",
    "e1": "0 1px 2px rgba(16, 24, 40, 0.05)",
    "e2": "0 4px 8px -2px rgba(16, 24, 40, 0.08), 0 2px 4px -2px rgba(16, 24, 40, 0.04)",
    "e3": "0 12px 24px -6px rgba(16, 24, 40, 0.12)"
  },

  "motion": {
    "fast": "120ms",
    "base": "160ms",
    "slow": "220ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)"
  },

  "layout": {
    "sidebar-expanded": "16.5rem",
    "sidebar-rail": "4rem",
    "topbar-height": "3.5rem",
    "content-max": "97.5rem",
    "drawer-md": "32.5rem",
    "drawer-lg": "35rem",
    "row-compact": "2rem",
    "row-default": "2.5rem",
    "row-comfortable": "3rem"
  }
}
